{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "semi": true,
  "plugins": ["prettier-plugin-wxml"],
  "overrides": [
    {
      "files": "*.wxml",
      "options": { "parser": "wxml" }
    },
    {
      "files": "*.wxss",
      "options": { "parser": "css" }
    }
  ]
}
