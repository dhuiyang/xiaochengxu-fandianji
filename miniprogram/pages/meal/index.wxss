.hero {
  padding: 12rpx 4rpx 30rpx;
}
.kicker {
  color: #c0784b;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}
.hero-sub {
  margin-top: 14rpx;
  color: #9c8e83;
  font-size: 26rpx;
  line-height: 1.6;
}
.filter-row {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  margin: 0 -4rpx 20rpx;
}
.filter {
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  color: #927b6d;
  background: #fff0e5;
  border-radius: 36rpx;
  font-size: 25rpx;
}
.filter.active {
  color: #fff;
  background: #e87837;
}
.dish-list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
}
.dish-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5eee9;
}
.dish-row:last-child {
  border: 0;
}
.dish-row.selected {
  background: #fff8f2;
}
.dish-emoji {
  flex: none;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 39rpx;
  background: #f9eee4;
}
.dish-image {
  display: block;
}
.dish-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: 29rpx;
  font-weight: 600;
}
.dish-copy view:last-child {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #a2948b;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 32rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.check {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border: 2rpx solid #e8b491;
  border-radius: 50%;
  color: #fff;
  background: #fff;
  text-align: center;
}
.selected .check {
  border-color: #e87837;
  background: #e87837;
}
.note-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
}
.note-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.note-card textarea {
  width: 100%;
  min-height: 88rpx;
  color: #4d4039;
  font-size: 27rpx;
  line-height: 1.5;
}
.bottom-action {
  padding-top: 28rpx;
}
