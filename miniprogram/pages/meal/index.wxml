<view class="page">
  <view class="hero">
    <view class="kicker">{{ mealDateLabel }} · {{ mealName }}</view>
    <view class="hero-title">
      {{ isConfirm ? '确认' + mealName + '菜单' : '选几道' + mealName + '想吃的菜' }}
    </view>
    <view class="hero-sub">
      {{ isConfirm ? '确认后将同步到所有家人的饮食记录' : '主厨确认前，都可以继续增减或修改备注' }}
    </view>
  </view>
  <view class="filter-row">
    <view
      wx:for="{{ categories }}"
      class="filter {{ activeCategory === item ? 'active' : '' }}"
      wx:key="*this"
      data-category="{{ item }}"
      bindtap="filterCategory"
    >
      {{ item }}
    </view>
  </view>
  <view class="dish-list">
    <view
      wx:for="{{ visibleDishes }}"
      class="dish-row {{ item.selected ? 'selected' : '' }}"
      wx:key="_id"
      data-id="{{ item._id }}"
      bindtap="toggleDish"
    >
      <image
        wx:if="{{ item.imageFileId }}"
        class="dish-emoji dish-image"
        src="{{ item.imageFileId }}"
        mode="aspectFill"
        data-id="{{ item._id }}"
        catchtap="viewDish"
      />
      <view wx:else="" class="dish-emoji" data-id="{{ item._id }}" catchtap="viewDish">
        {{ item.emoji }}
      </view>
      <view class="dish-copy" data-id="{{ item._id }}" catchtap="viewDish">
        <view>{{ item.name }}</view>
        <view>{{ item.description }}</view>
      </view>
      <view class="check">{{ item.selected ? '✓' : '' }}</view>
    </view>
  </view>
  <view wx:if="{{ !isConfirm }}" class="note-card">
    <view class="note-label">备注（可选）</view>
    <textarea
      maxlength="60"
      value="{{ note }}"
      placeholder="例如：少辣、不要香菜"
      auto-height="true"
      bindinput="onNoteInput"
    />
  </view>
  <view class="bottom-action">
    <button class="primary-btn" bindtap="submit">
      {{ isConfirm ? '确认' + mealName + '菜单' : '提交' + mealName + '点菜' }}
    </button>
  </view>
</view>


