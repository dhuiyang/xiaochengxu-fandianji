<view class="page">
  <view class="hero">
    <view class="kicker">8 月 11 日 · 午餐</view>
    <view class="hero-title">{{ isConfirm ? '确认今日菜单' : '选几道想吃的菜' }}</view>
    <view class="hero-sub">
      {{ isConfirm ? '确认后将同步到所有家人的饮食记录' : '主厨确认前，都可以继续增减或修改备注' }}
    </view>
  </view>
  <view class="filter-row">
    <view
      wx:for="{{ categories }}"
      class="filter {{ activeCategory === item ? 'active' : '' }}"
      wx:key="*this"
      data-category="{{ item }}"
      bindtap="filterCategory"
    >
      {{ item }}
    </view>
  </view>
  <view class="dish-list">
    <view
      wx:for="{{ visibleDishes }}"
      class="dish-row {{ item.selected ? 'selected' : '' }}"
      wx:key="_id"
      data-id="{{ item._id }}"
      bindtap="toggleDish"
    >
      <view class="dish-emoji">{{ item.emoji }}</view>
      <view class="dish-copy"><view>{{ item.name }}</view><view>{{ item.description }}</view></view>
      <view class="check">{{ item.selected ? '✓' : '' }}</view>
    </view>
  </view>
  <view wx:if="{{ !isConfirm }}" class="note-card">
    <view class="note-label">备注（可选）</view>
    <textarea
      maxlength="60"
      value="{{ note }}"
      placeholder="例如：少辣、不要香菜"
      auto-height="true"
      bindinput="onNoteInput"
    />
  </view>
  <view class="bottom-action">
    <button class="primary-btn" bindtap="submit">
      {{ isConfirm ? '确认今日菜单' : '提交点菜' }}
    </button>
  </view>
</view>


