<view class="page">
  <view class="heading">饮食记录</view>
  <view class="muted intro">记录每一顿认真吃过的饭</view>
  <view wx:if="{{ isLoading && !hasLoaded }}" class="loading-state">
    <view class="loading-spinner" />
    <text>记录加载中</text>
  </view>
  <view class="record-list" wx:elif="{{ records.length }}">
    <view wx:for="{{ records }}" class="record card" wx:key="time">
      <view class="record-date">
        <view>
          <view class="date-main">{{ item.date }}</view>
          <view class="muted">
            {{ item.mealLabel }} · {{ item.time }} · 由{{ item.confirmer }}主厨
          </view>
        </view>
        <view class="record-icon">🍽</view>
      </view>
      <view class="menu-items">
        <text wx:for="{{ item.dishes }}" class="menu-item" wx:key="*this">{{ item }}</text>
      </view>
    </view>
  </view>
  <view wx:else="" class="empty-box">
    <view>🥣</view>
    <view>还没有饮食记录</view>
    <text>确认一餐菜单后，会自动沉淀在这里</text>
  </view>
</view>


