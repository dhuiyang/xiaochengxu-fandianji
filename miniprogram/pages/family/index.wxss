.family-head {
  display: flex;
  align-items: center;
  margin: 20rpx 0 30rpx;
}
.family-head.editable {
  position: relative;
}
.house {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: #ffe4cb;
  border-radius: 32rpx;
  font-size: 50rpx;
}
.house-image {
  flex: none;
  display: block;
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
}
.family-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.family-edit-hint {
  flex: none;
  margin-left: auto;
  padding: 10rpx 16rpx;
  color: #c67a4b;
  background: #fff0e5;
  border-radius: 99rpx;
  font-size: 22rpx;
}
.heading {
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.family-description {
  display: -webkit-box;
  overflow: hidden;
  color: #9c8e83;
  font-size: 22rpx;
  line-height: 32rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.switch-family {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx 0 24rpx;
  padding: 20rpx 24rpx;
  color: #7f5e4b;
  background: #fff3e8;
  border-radius: 20rpx;
}
.switch-family-title {
  font-size: 27rpx;
  font-weight: 600;
}
.switch-family-desc {
  margin-top: 6rpx;
  color: #aa9385;
  font-size: 22rpx;
}
.switch-family-arrow {
  color: #cf916d;
  font-size: 40rpx;
  font-weight: 300;
}
.invite {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #fff 0%, #fff3e7 100%);
}
.invite-copy {
  flex: 1;
  min-width: 0;
}
.small-title {
  color: #a47b62;
  font-size: 23rpx;
  font-weight: 600;
}
.invite-code {
  margin: 10rpx 0 8rpx;
  color: #df7132;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 48rpx;
}
.invite-desc {
  color: #aa9a90;
  font-size: 21rpx;
  line-height: 30rpx;
}
.copy-btn {
  flex: none;
  min-width: 138rpx;
  box-sizing: border-box;
  padding: 15rpx 22rpx;
  color: #d4672b;
  background: #fff;
  border: 0;
  border-radius: 32rpx;
  box-shadow: inset 0 0 0 2rpx #efbd9d;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 36rpx;
}
.members {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}
.member {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4ece7;
}
.member:last-child {
  border: 0;
}
.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  color: #985229;
  background: #ffdfc7;
  font-weight: 700;
}
.member-avatar-image {
  display: block;
}
.member-avatar.green {
  color: #517649;
  background: #dfeeda;
}
.member-avatar.blue {
  color: #4b708d;
  background: #deecf7;
}
.member-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: 28rpx;
}
.member-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}
.member-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-copy .muted {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.role {
  flex: none;
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  color: #c1632f;
  background: #fff0e4;
  border-radius: 8rpx;
  font-size: 20rpx;
}
.role.chef {
  color: #5d7948;
  background: #e5f0dc;
}
.role.owner {
  color: #c1632f;
  background: #fff0e4;
}
.member-manage {
  flex: none;
  white-space: nowrap;
  padding: 10rpx 0 10rpx 16rpx;
  color: #d4672b;
  font-size: 24rpx;
}
.role-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 41, 35, 0.38);
}
.role-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(38rpx + env(safe-area-inset-bottom));
  background: #fffaf5;
  border-radius: 40rpx 40rpx 0 0;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: #eadbd0;
}
.role-sheet-title {
  font-size: 36rpx;
  font-weight: 700;
}
.role-sheet-subtitle {
  margin-top: 8rpx;
  color: #9c8e83;
  font-size: 24rpx;
}
.role-option {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
  background: #fff;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
}
.role-option.selected {
  border-color: #e87837;
  background: #fff8f2;
}
.role-option-icon {
  width: 60rpx;
  font-size: 42rpx;
}
.role-option-copy {
  flex: 1;
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.role-option-copy text {
  display: block;
  margin-top: 8rpx;
  color: #9c8e83;
  font-size: 22rpx;
  font-weight: 400;
}
.role-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #fff;
  background: #fff;
  border: 2rpx solid #e8b491;
  border-radius: 50%;
  font-size: 21rpx;
}
.selected .role-radio {
  background: #e87837;
  border-color: #e87837;
}
.role-save {
  height: 88rpx;
  margin-top: 26rpx;
  color: #fff;
  background: #e87837;
  border-radius: 44rpx;
  font-size: 29rpx;
  line-height: 88rpx;
}
.remove-member {
  margin-top: 26rpx;
  color: #d96829;
  font-size: 26rpx;
  text-align: center;
}
.family-avatar-picker {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  margin: 26rpx auto;
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffe4cb;
}
.family-avatar-image,
.family-avatar-placeholder {
  width: 100%;
  height: 100%;
}
.family-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}
.family-avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 9rpx 0;
  color: #fff;
  background: rgba(54, 42, 34, 0.58);
  font-size: 21rpx;
  text-align: center;
}
.family-name-field {
  padding: 18rpx 0 22rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.family-name-field input {
  height: 72rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 400;
}
.family-description-field {
  padding: 4rpx 0 4rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.family-description-field text {
  margin-left: 6rpx;
  color: #ad9b91;
  font-size: 22rpx;
  font-weight: 400;
}
.family-description-field textarea {
  width: 100%;
  min-height: 108rpx;
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 38rpx;
}
.reset {
  display: block;
  margin: 40rpx auto 0;
  color: #ad9990;
  font-size: 25rpx;
}
.family-skeleton-line,
.family-skeleton-house,
.family-skeleton-button,
.family-skeleton-avatar,
.family-skeleton-edit,
.family-skeleton-member-action {
  background: #f8e9dd;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.family-skeleton-line {
  border-radius: 10rpx;
}
.family-skeleton-house {
  flex: none;
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
}
.family-skeleton-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.family-skeleton-edit {
  flex: none;
  width: 68rpx;
  height: 42rpx;
  margin-left: 18rpx;
  border-radius: 99rpx;
}
.family-skeleton-name {
  width: 210rpx;
  height: 38rpx;
  margin-bottom: 16rpx;
}
.family-skeleton-subtitle {
  width: 260rpx;
  height: 24rpx;
}
.skeleton-switch-family {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx 0 24rpx;
  padding: 20rpx 24rpx;
  background: #fff3e8;
  border-radius: 20rpx;
}
.family-skeleton-switch-title {
  width: 110rpx;
  height: 24rpx;
  margin-bottom: 10rpx;
}
.family-skeleton-switch-copy {
  width: 150rpx;
  height: 18rpx;
}
.family-skeleton-switch-arrow {
  width: 18rpx;
  height: 30rpx;
}
.skeleton-invite {
  min-height: 164rpx;
}
.family-skeleton-label {
  width: 110rpx;
  height: 20rpx;
  margin-bottom: 16rpx;
}
.family-skeleton-code {
  width: 190rpx;
  height: 38rpx;
  margin-bottom: 16rpx;
}
.family-skeleton-copy {
  width: 246rpx;
  height: 24rpx;
}
.family-skeleton-button {
  width: 180rpx;
  height: 64rpx;
  border-radius: 32rpx;
}
.family-skeleton-section {
  width: 160rpx;
  height: 34rpx;
  margin: 42rpx 0 24rpx;
}
.skeleton-members {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}
.skeleton-member {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4ece7;
}
.skeleton-member:last-child {
  border: 0;
}
.family-skeleton-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
}
.family-skeleton-member-name {
  width: 210rpx;
  height: 26rpx;
  margin: 0 0 12rpx 18rpx;
}
.family-skeleton-member-copy {
  width: 150rpx;
  height: 20rpx;
  margin-left: 18rpx;
}
.family-skeleton-member-action {
  width: 56rpx;
  height: 22rpx;
  margin-left: auto;
  border-radius: 10rpx;
}
@keyframes skeleton-pulse {
  from {
    opacity: 0.55;
  }
  to {
    opacity: 1;
  }
}
