.family-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0 30rpx;
}
.house {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: #ffe4cb;
  border-radius: 32rpx;
  font-size: 50rpx;
}
.heading {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.switch-family {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx 0 24rpx;
  padding: 20rpx 24rpx;
  color: #7f5e4b;
  background: #fff3e8;
  border-radius: 20rpx;
}
.switch-family-title {
  font-size: 27rpx;
  font-weight: 600;
}
.switch-family-desc {
  margin-top: 6rpx;
  color: #aa9385;
  font-size: 22rpx;
}
.switch-family-arrow {
  color: #cf916d;
  font-size: 40rpx;
  font-weight: 300;
}
.invite {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fff 0%, #fff3e7 100%);
}
.small-title {
  color: #a47b62;
  font-size: 24rpx;
}
.invite-code {
  margin: 8rpx 0;
  color: #df7132;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}
.copy-btn {
  box-sizing: border-box;
  padding: 14rpx 24rpx;
  color: #d4672b;
  background: #fff;
  border: 0;
  border-radius: 32rpx;
  box-shadow: inset 0 0 0 2rpx #efbd9d;
  font-size: 26rpx;
}
.members {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}
.member {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4ece7;
}
.member:last-child {
  border: 0;
}
.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  color: #985229;
  background: #ffdfc7;
  font-weight: 700;
}
.member-avatar.green {
  color: #517649;
  background: #dfeeda;
}
.member-avatar.blue {
  color: #4b708d;
  background: #deecf7;
}
.member-copy {
  margin-left: 18rpx;
  font-size: 28rpx;
}
.member-copy .muted {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.role {
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  color: #c1632f;
  background: #fff0e4;
  border-radius: 8rpx;
  font-size: 20rpx;
}
.reset {
  display: block;
  margin: 40rpx auto 0;
  color: #ad9990;
  font-size: 25rpx;
}
.family-skeleton-line,
.family-skeleton-house,
.family-skeleton-button,
.family-skeleton-avatar {
  background: #f8e9dd;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.family-skeleton-line {
  border-radius: 10rpx;
}
.family-skeleton-house {
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
}
.family-skeleton-name {
  width: 210rpx;
  height: 38rpx;
  margin-bottom: 16rpx;
}
.family-skeleton-subtitle {
  width: 260rpx;
  height: 24rpx;
}
.skeleton-switch-family {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx 0 24rpx;
  padding: 20rpx 24rpx;
  background: #fff3e8;
  border-radius: 20rpx;
}
.family-skeleton-switch-title {
  width: 110rpx;
  height: 24rpx;
  margin-bottom: 10rpx;
}
.family-skeleton-switch-copy {
  width: 150rpx;
  height: 18rpx;
}
.family-skeleton-switch-arrow {
  width: 18rpx;
  height: 30rpx;
}
.skeleton-invite {
  min-height: 172rpx;
}
.family-skeleton-label {
  width: 110rpx;
  height: 20rpx;
  margin-bottom: 16rpx;
}
.family-skeleton-code {
  width: 190rpx;
  height: 38rpx;
  margin-bottom: 16rpx;
}
.family-skeleton-copy {
  width: 246rpx;
  height: 24rpx;
}
.family-skeleton-button {
  width: 180rpx;
  height: 64rpx;
  border-radius: 32rpx;
}
.family-skeleton-section {
  width: 160rpx;
  height: 34rpx;
  margin: 42rpx 0 24rpx;
}
.skeleton-members {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}
.skeleton-member {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.family-skeleton-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
}
.family-skeleton-member-name {
  width: 210rpx;
  height: 26rpx;
  margin: 0 0 12rpx 18rpx;
}
.family-skeleton-member-copy {
  width: 150rpx;
  height: 20rpx;
  margin-left: 18rpx;
}
@keyframes skeleton-pulse {
  from {
    opacity: 0.55;
  }
  to {
    opacity: 1;
  }
}
