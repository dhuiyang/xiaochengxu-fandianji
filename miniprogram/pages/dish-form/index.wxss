.form {
  margin: 18rpx 0 28rpx;
}
.field {
  padding: 18rpx 0 26rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f4ece7;
}
.field:last-child {
  border: 0;
}
.field input,
.field textarea {
  width: 100%;
  margin-top: 18rpx;
  color: #44362e;
  font-size: 27rpx;
  font-weight: 400;
}
.field textarea {
  min-height: 100rpx;
}
.picker {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: #9b887e;
  font-weight: 400;
}
.emoji-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  background: #faf0e8;
  border-radius: 18rpx;
  font-size: 34rpx;
}
.emoji.selected {
  background: #ffe0c8;
  outline: 3rpx solid #e87837;
}
