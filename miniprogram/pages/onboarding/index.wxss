.brand {
  padding: 110rpx 0 64rpx;
  text-align: center;
}
.brand-icon {
  font-size: 100rpx;
}
.brand-title {
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 700;
}
.brand-sub,
.footnote {
  margin-top: 14rpx;
  color: #9e8c81;
  font-size: 26rpx;
}
.choice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.choice-card {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(119, 82, 54, 0.07);
}
.choice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-right: 22rpx;
  border-radius: 26rpx;
  background: #fff0e5;
  font-size: 44rpx;
}
.join-choice .choice-icon {
  background: #e7f1e2;
}
.choice-copy {
  flex: 1;
}
.choice-title {
  font-size: 32rpx;
  font-weight: 700;
}
.choice-desc {
  margin-top: 10rpx;
  color: #9c8e83;
  font-size: 24rpx;
}
.choice-arrow {
  color: #c18f70;
  font-size: 44rpx;
  font-weight: 300;
}
.form-heading {
  margin: 0 0 22rpx;
}
.back-choice {
  display: inline-block;
  margin-bottom: 18rpx;
  color: #b07858;
  font-size: 25rpx;
}
.form-title {
  font-size: 38rpx;
  font-weight: 700;
}
.field {
  padding: 20rpx 0;
  font-size: 27rpx;
  font-weight: 600;
}
.field input {
  margin-top: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee3dc;
  color: #45372f;
  font-size: 28rpx;
  font-weight: 400;
}
.card .primary-btn {
  margin-top: 28rpx;
}
.footnote {
  padding: 22rpx;
  text-align: center;
  line-height: 1.6;
}
