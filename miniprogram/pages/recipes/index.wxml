<view class="page">
  <view class="title-row">
    <view>
      <view class="heading">家庭菜谱</view>
      <view class="muted">{{ dishes.length }} 道家常菜</view>
    </view>
    <view wx:if="{{ canManage }}" class="add" bindtap="goAdd">＋</view>
  </view>
  <input class="search" placeholder="搜索菜名" bindinput="search" />
  <view class="chips">
    <view
      wx:for="{{ categories }}"
      class="chip {{ activeCategory === item ? 'active' : '' }}"
      wx:key="*this"
      data-category="{{ item }}"
      bindtap="filter"
    >
      {{ item }}
    </view>
  </view>
  <view wx:if="{{ isLoading && !hasLoaded }}" class="loading-state">
    <view class="loading-spinner" />
    <text>菜谱加载中</text>
  </view>
  <view class="grid" wx:elif="{{ visibleDishes.length }}">
    <view wx:for="{{ visibleDishes }}" class="dish-card" wx:key="_id">
      <image
        wx:if="{{ item.imageUrl }}"
        class="food-image"
        src="{{ item.imageUrl }}"
        mode="aspectFill"
      />
      <view wx:else="" class="food">{{ item.emoji }}</view>
      <view class="dish-content">
        <view class="dish-name">{{ item.name }}</view>
        <view class="dish-desc">{{ item.description }}</view>
        <view class="dish-footer">
          <view class="pill">{{ item.category }}</view>
          <view wx:if="{{ canManage }}" class="dish-actions">
            <text class="dish-edit" data-id="{{ item._id }}" catchtap="goEdit">编辑</text>
            <text class="dish-delete" data-id="{{ item._id }}" catchtap="deleteDish">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else="" class="empty">没有找到相关菜品</view>
</view>


