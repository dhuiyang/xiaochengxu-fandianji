.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 24rpx;
}
.heading {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.add {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #fff;
  background: #e87837;
  font-size: 48rpx;
  font-weight: 300;
}
.search {
  height: 78rpx;
  padding: 0 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}
.chips {
  display: flex;
  overflow-x: auto;
  padding: 22rpx 0;
  white-space: nowrap;
}
.chip {
  margin-right: 14rpx;
  padding: 12rpx 22rpx;
  color: #907a6d;
  background: #fff0e5;
  border-radius: 32rpx;
  font-size: 24rpx;
}
.chip.active {
  color: #fff;
  background: #e87837;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.dish-card {
  width: calc(50% - 10rpx);
  min-width: 0;
  margin-bottom: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
}
.food {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 172rpx;
  border-radius: 18rpx;
  background: #faeee4;
  font-size: 80rpx;
}
.dish-name {
  margin: 18rpx 0 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}
.dish-desc {
  min-height: 34rpx;
  color: #9d8d83;
  font-size: 22rpx;
  line-height: 34rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.dish-card .pill {
  margin-top: 14rpx;
}
.empty {
  padding: 100rpx 0;
  color: #9c8e83;
  text-align: center;
}
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #9c8e83;
  font-size: 26rpx;
}
.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  border: 5rpx solid #f8dfcd;
  border-top-color: #e87837;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
