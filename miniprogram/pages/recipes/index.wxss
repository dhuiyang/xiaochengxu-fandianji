.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 24rpx;
}
.heading {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.add {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #fff;
  background: #e87837;
  font-size: 48rpx;
  font-weight: 300;
}
.search {
  height: 78rpx;
  padding: 0 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}
.chips {
  display: flex;
  overflow-x: auto;
  padding: 22rpx 0;
  white-space: nowrap;
}
.chip {
  margin-right: 14rpx;
  padding: 12rpx 22rpx;
  color: #907a6d;
  background: #fff0e5;
  border-radius: 32rpx;
  font-size: 24rpx;
}
.chip.active {
  color: #fff;
  background: #e87837;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  justify-content: space-between;
}
.dish-card {
  display: flex;
  min-height: 350rpx;
  flex-direction: column;
  width: calc(50% - 10rpx);
  min-width: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(104, 70, 48, 0.05);
}
.food {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 172rpx;
  background: linear-gradient(135deg, #fff2e9, #fae7d9);
  font-size: 80rpx;
}
.food-image {
  display: block;
  width: 100%;
  height: 172rpx;
}
.dish-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 18rpx 18rpx 16rpx;
}
.dish-name {
  overflow: hidden;
  color: #372b25;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-desc {
  display: -webkit-box;
  min-height: 60rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #9d8d83;
  font-size: 22rpx;
  line-height: 30rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  margin-top: auto;
  padding-top: 16rpx;
}
.dish-actions {
  display: flex;
  gap: 14rpx;
  align-items: center;
  font-size: 22rpx;
}
.dish-edit {
  color: #b97b56;
}
.dish-delete {
  padding-left: 14rpx;
  color: #d96829;
  border-left: 1rpx solid #f0ddd1;
}
.empty {
  padding: 100rpx 0;
  color: #9c8e83;
  text-align: center;
}
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #9c8e83;
  font-size: 26rpx;
}
.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  border: 5rpx solid #f8dfcd;
  border-top-color: #e87837;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
