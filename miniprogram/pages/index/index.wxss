.greeting,
.card-top,
.request,
.quick-row {
  display: flex;
  align-items: center;
}
.greeting {
  justify-content: space-between;
  margin: 10rpx 4rpx 26rpx;
}
.eyebrow {
  color: #a59387;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.headline {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.avatar,
.mini-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: 600;
}
.avatar {
  position: relative;
  overflow: hidden;
  width: 76rpx;
  height: 76rpx;
  color: #fff;
  background: #eeb17e;
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.mini-avatar {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  color: #9e5429;
  background: #fde2cb;
  font-size: 24rpx;
}
.meal-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  background: #fff0e5;
  border-radius: 48rpx;
  font-size: 26rpx;
}
.switch-item {
  padding: 14rpx 26rpx;
  color: #967b6d;
}
.switch-item.active {
  background: #fff;
  color: #d9692c;
  border-radius: 36rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(180, 111, 61, 0.08);
}
.switch-time {
  margin-left: auto;
  padding-right: 14rpx;
  color: #b49a8a;
  font-size: 21rpx;
}
.order-card {
  background: linear-gradient(135deg, #fff 0%, #fff5ea 100%);
}
.recommend-entry {
  margin-top: 18rpx;
  color: #c96a31;
  font-size: 25rpx;
  text-align: center;
}
.skeleton-card {
  margin-top: 20rpx;
}
.skeleton-greeting {
  margin-bottom: 26rpx;
}
.skeleton-eyebrow {
  width: 138rpx;
  height: 20rpx;
  margin-bottom: 14rpx;
}
.skeleton-headline {
  width: 286rpx;
  height: 46rpx;
}
.skeleton-profile-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f8e9dd;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.skeleton-meal-switch {
  display: flex;
  align-items: center;
  height: 96rpx;
  margin-bottom: 24rpx;
  padding: 10rpx;
  box-sizing: border-box;
  background: #fff0e5;
  border-radius: 48rpx;
}
.skeleton-switch-item,
.skeleton-switch-time,
.skeleton-recommend-entry,
.skeleton-quick-item {
  background: #f8e9dd;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.skeleton-switch-item {
  width: 92rpx;
  height: 54rpx;
  margin-right: 10rpx;
  border-radius: 36rpx;
}
.skeleton-switch-item.active {
  background: #fff;
}
.skeleton-switch-time {
  width: 180rpx;
  height: 22rpx;
  margin-left: auto;
  margin-right: 14rpx;
  border-radius: 10rpx;
}
.skeleton-recommend-entry {
  width: 190rpx;
  height: 22rpx;
  margin: 22rpx auto 0;
  border-radius: 10rpx;
}
.skeleton-quick-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.skeleton-quick-item {
  flex: 1;
  height: 126rpx;
  border-radius: 24rpx;
}
.skeleton-order {
  margin-top: 0;
}
.skeleton-top,
.skeleton-request {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.skeleton-line,
.skeleton-icon,
.skeleton-button,
.skeleton-avatar {
  background: #f8e9dd;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.skeleton-line {
  border-radius: 10rpx;
}
.skeleton-label {
  width: 104rpx;
  height: 20rpx;
  margin-bottom: 16rpx;
}
.skeleton-title {
  width: 224rpx;
  height: 34rpx;
  margin-bottom: 14rpx;
}
.skeleton-copy {
  width: 172rpx;
  height: 22rpx;
}
.skeleton-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
}
.skeleton-icon.warm {
  background: #fae6d5;
}
.skeleton-button {
  width: 360rpx;
  height: 76rpx;
  margin: 30rpx auto 0;
  border-radius: 48rpx;
}
.skeleton-button.secondary {
  width: 320rpx;
}
.skeleton-requests {
  margin-top: 38rpx;
}
.skeleton-section-title {
  width: 190rpx;
  height: 34rpx;
}
.skeleton-request {
  justify-content: flex-start;
  margin-top: 32rpx;
}
.skeleton-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
}
.skeleton-request-title {
  width: 220rpx;
  height: 26rpx;
  margin: 0 0 12rpx 18rpx;
}
.skeleton-request-copy {
  width: 160rpx;
  height: 20rpx;
  margin-left: 18rpx;
}
@keyframes skeleton-pulse {
  from {
    opacity: 0.55;
  }
  to {
    opacity: 1;
  }
}
.confirm-card {
  margin-top: 20rpx;
}
.card-top {
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-label {
  color: #b37c5c;
  font-size: 24rpx;
  margin-bottom: 9rpx;
}
.order-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.order-note,
.request-note {
  color: #a07158;
  font-size: 24rpx;
}
.emoji-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #e4f0df;
  font-size: 44rpx;
}
.emoji-circle.warm {
  background: #ffe0c5;
}
.requests {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}
.requests-section {
  margin-top: 38rpx;
}
.requests-title {
  font-size: 34rpx;
  font-weight: 700;
}
.empty-requests {
  padding: 40rpx 0 20rpx;
  color: #a59387;
  text-align: center;
  font-size: 26rpx;
}
.request {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2e9e2;
}
.request:last-child {
  border: 0;
}
.request-copy {
  margin-left: 18rpx;
  font-size: 28rpx;
}
.request-name {
  font-weight: 600;
}
.request-note {
  margin-top: 8rpx;
}
.quick-row {
  gap: 20rpx;
  margin-top: 24rpx;
}
.quick-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  color: #765f52;
  background: #fff;
  border-radius: 24rpx;
  font-size: 25rpx;
  box-shadow: 0 8rpx 26rpx rgba(119, 82, 54, 0.05);
}
.quick-item text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 36rpx;
}
.recommend-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 41, 35, 0.38);
}
.profile-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 41, 35, 0.38);
}
.profile-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(38rpx + env(safe-area-inset-bottom));
  background: #fffaf5;
  border-radius: 40rpx 40rpx 0 0;
}
.profile-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
}
.profile-avatar-picker {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  margin: 30rpx auto;
  overflow: hidden;
  border-radius: 50%;
  background: #f6bc88;
}
.profile-avatar-image,
.profile-avatar-placeholder {
  width: 100%;
  height: 100%;
}
.profile-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 52rpx;
  font-weight: 600;
}
.profile-avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 9rpx 0;
  color: #fff;
  background: rgba(54, 42, 34, 0.58);
  font-size: 21rpx;
  text-align: center;
}
.profile-field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0e5dc;
}
.profile-field-label {
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.profile-field input {
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  font-size: 27rpx;
}
.profile-save {
  height: 88rpx;
  margin-top: 30rpx;
  color: #fff;
  background: #e87837;
  border-radius: 44rpx;
  font-size: 29rpx;
  line-height: 88rpx;
}
.recommend-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(38rpx + env(safe-area-inset-bottom));
  background: #fffaf5;
  border-radius: 40rpx 40rpx 0 0;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: #eadbd0;
}
.recommend-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recommend-title {
  font-size: 36rpx;
  font-weight: 700;
}
.recommend-subtitle,
.recommend-meta {
  margin-top: 8rpx;
  color: #9c8e83;
  font-size: 24rpx;
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  color: #927b6d;
  font-size: 48rpx;
  line-height: 48rpx;
  text-align: center;
}
.recommend-filters {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}
.recommend-filter {
  padding: 10rpx 19rpx;
  color: #927b6d;
  background: #fff0e5;
  border-radius: 99rpx;
  font-size: 23rpx;
}
.recommend-filter.active {
  color: #fff;
  background: #e87837;
}
.recommend-result,
.recommend-loading {
  min-height: 230rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  text-align: center;
  background: #fff;
  border-radius: 28rpx;
}
.recommend-loading {
  padding-top: 92rpx;
  color: #a59387;
  font-size: 27rpx;
}
.recommend-emoji {
  font-size: 74rpx;
}
.recommend-image {
  display: block;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 18rpx;
}
.recommend-name {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}
.recommend-reason {
  margin-top: 20rpx;
  color: #c0784b;
  font-size: 22rpx;
}
.recommend-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}
.recommend-actions button {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 44rpx;
  font-size: 27rpx;
}
.recommend-refresh {
  color: #c96a31;
  background: #fff0e5;
}
.recommend-add {
  color: #fff;
  background: #e87837;
}
