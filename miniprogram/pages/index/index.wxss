.greeting,
.card-top,
.request,
.quick-row {
  display: flex;
  align-items: center;
}
.greeting {
  justify-content: space-between;
  margin: 10rpx 4rpx 26rpx;
}
.eyebrow {
  color: #a59387;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.headline {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.avatar,
.mini-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-weight: 600;
}
.avatar {
  width: 76rpx;
  height: 76rpx;
  color: #fff;
  background: #eeb17e;
}
.mini-avatar {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  color: #9e5429;
  background: #fde2cb;
  font-size: 24rpx;
}
.meal-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  background: #fff0e5;
  border-radius: 48rpx;
  font-size: 26rpx;
}
.switch-item {
  padding: 14rpx 26rpx;
  color: #967b6d;
}
.switch-item.active {
  background: #fff;
  color: #d9692c;
  border-radius: 36rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(180, 111, 61, 0.08);
}
.switch-time {
  margin-left: auto;
  padding-right: 14rpx;
  color: #b49a8a;
  font-size: 21rpx;
}
.order-card {
  background: linear-gradient(135deg, #fff 0%, #fff5ea 100%);
}
.skeleton-card {
  margin-top: 20rpx;
}
.skeleton-order {
  margin-top: 0;
}
.skeleton-top,
.skeleton-request {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.skeleton-line,
.skeleton-icon,
.skeleton-button,
.skeleton-avatar {
  background: #f8e9dd;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}
.skeleton-line {
  border-radius: 10rpx;
}
.skeleton-label {
  width: 104rpx;
  height: 20rpx;
  margin-bottom: 16rpx;
}
.skeleton-title {
  width: 224rpx;
  height: 34rpx;
  margin-bottom: 14rpx;
}
.skeleton-copy {
  width: 172rpx;
  height: 22rpx;
}
.skeleton-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
}
.skeleton-icon.warm {
  background: #fae6d5;
}
.skeleton-button {
  width: 360rpx;
  height: 76rpx;
  margin: 30rpx auto 0;
  border-radius: 48rpx;
}
.skeleton-button.secondary {
  width: 320rpx;
}
.skeleton-requests {
  margin-top: 38rpx;
}
.skeleton-section-title {
  width: 190rpx;
  height: 34rpx;
}
.skeleton-request {
  justify-content: flex-start;
  margin-top: 32rpx;
}
.skeleton-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
}
.skeleton-request-title {
  width: 220rpx;
  height: 26rpx;
  margin: 0 0 12rpx 18rpx;
}
.skeleton-request-copy {
  width: 160rpx;
  height: 20rpx;
  margin-left: 18rpx;
}
@keyframes skeleton-pulse {
  from {
    opacity: 0.55;
  }
  to {
    opacity: 1;
  }
}
.confirm-card {
  margin-top: 20rpx;
}
.card-top {
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-label {
  color: #b37c5c;
  font-size: 24rpx;
  margin-bottom: 9rpx;
}
.order-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.order-note,
.request-note {
  color: #a07158;
  font-size: 24rpx;
}
.emoji-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #e4f0df;
  font-size: 44rpx;
}
.emoji-circle.warm {
  background: #ffe0c5;
}
.requests {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}
.requests-section {
  margin-top: 38rpx;
}
.requests-title {
  font-size: 34rpx;
  font-weight: 700;
}
.empty-requests {
  padding: 40rpx 0 20rpx;
  color: #a59387;
  text-align: center;
  font-size: 26rpx;
}
.request {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2e9e2;
}
.request:last-child {
  border: 0;
}
.request-copy {
  margin-left: 18rpx;
  font-size: 28rpx;
}
.request-name {
  font-weight: 600;
}
.request-note {
  margin-top: 8rpx;
}
.quick-row {
  gap: 20rpx;
  margin-top: 24rpx;
}
.quick-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  color: #765f52;
  background: #fff;
  border-radius: 24rpx;
  font-size: 25rpx;
  box-shadow: 0 8rpx 26rpx rgba(119, 82, 54, 0.05);
}
.quick-item text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 36rpx;
}
