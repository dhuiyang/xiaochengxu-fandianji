<view class="page">
  <view class="greeting">
    <view>
      <view class="eyebrow">{{ dateLabel }}</view>
      <view class="headline">今天吃点什么？</view>
    </view>
    <view class="avatar">{{ userAvatar }}</view>
  </view>
  <view class="meal-switch">
    <view class="switch-item {{ activeMeal === 'lunch' ? 'active' : '' }}">午餐</view>
    <view class="switch-item {{ activeMeal === 'dinner' ? 'active' : '' }}">晚餐</view>
    <view class="switch-time">{{ mealCountdown }}</view>
  </view>

  <view class="card order-card">
    <view class="card-top">
      <view>
        <view class="card-label">我的点菜</view>
        <view class="order-title">{{ myOrderText }}</view>
        <view wx:if="{{ myNote }}" class="order-note">备注：{{ myNote }}</view>
        <view wx:else="" class="muted">选几道你想吃的菜吧</view>
      </view>
      <view class="emoji-circle">🥢</view>
    </view>
    <button class="primary-btn" bindtap="goOrder">
      {{ myOrderText === '还没点菜' ? '我要点菜' : '修改我的点菜' }}
    </button>
  </view>

  <view wx:if="{{ isChef }}" class="card confirm-card">
    <view class="card-top">
      <view>
        <view class="card-label">今日午餐</view>
        <view class="order-title">{{ confirmed ? '菜单已确认' : '等待确认菜单' }}</view>
        <view class="muted">
          {{ confirmed ? confirmedText : familyRequestCount + ' 位家人已点菜' }}
        </view>
      </view>
      <view class="emoji-circle warm">🍲</view>
    </view>
    <button class="secondary-btn" bindtap="goConfirm">
      {{ confirmed ? '查看今日菜单' : '确认今日菜单' }}
    </button>
  </view>

  <view class="card requests-section">
    <view class="requests-title">家人想吃什么</view>
    <view wx:if="{{ requests.length }}" class="requests">
      <view wx:for="{{ requests }}" class="request" wx:key="name">
        <view class="mini-avatar">{{ item.avatar }}</view>
        <view class="request-copy">
          <view>
            <text class="request-name">{{ item.name }}</text>
            <text>· {{ item.dishes }}</text>
          </view>
          <view wx:if="{{ item.note }}" class="request-note">“{{ item.note }}”</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-requests">暂无选择的菜品</view>
  </view>
  <view class="quick-row">
    <view class="quick-item" bindtap="goRecipes"><text>📖</text><view>看看菜谱</view></view>
    <view class="quick-item" bindtap="goRecords"><text>🗓</text><view>饮食记录</view></view>
  </view>
</view>
